@page "/"
@attribute [Authorize]
@inherits WorkspacePage
<PageTitle>Resumen · Credia</PageTitle>
<div class="page-heading"><div><div class="eyebrow">PORTAL COMERCIAL</div><h1>Resumen de operación</h1><p>Estado de las solicitudes al @Ui.Colombia(DateTime.UtcNow).ToString("dd MMM yyyy", Ui.Culture).</p></div><div class="heading-actions">@if (Roles.CanWrite(CurrentActor.Role)) {
    <a class="btn primary" href="/solicitudes/nueva"><Icon Name="plus" Size="18" /> Nueva solicitud</a>
}</div></div>
<Feedback Error="Error" />
@if (Loading) {
    <div class="loading"><span class="spinner"></span>Cargando solicitudes…</div>
}
<div class="metric-grid">
    <div class="metric-card"><div class="metric-label">Solicitudes <span class="metric-icon violet"><Icon Name="file" /></span></div><div class="metric-value">@apps.Count</div><div class="metric-foot">Expedientes registrados</div></div>
    <div class="metric-card"><div class="metric-label">Monto gestionado <span class="metric-icon blue"><Icon Name="wallet" /></span></div><div class="metric-value">@Ui.Compact(apps.Where(a => a.Status != ApplicationStatus.Rejected).Sum(a => a.Amount)) <span class="metric-context">COP</span></div><div class="metric-foot">Activas y aprobadas</div></div>
    <div class="metric-card"><div class="metric-label">Pendientes de revisión <span class="metric-icon amber"><Icon Name="clock" /></span></div><div class="metric-value">@Pending</div><div class="metric-foot">@apps.Count(a => a.Status == ApplicationStatus.Submitted) recibidas · @apps.Count(a => a.Status == ApplicationStatus.InReview) en análisis</div></div>
    <div class="metric-card"><div class="metric-label">Aprobación <span class="metric-icon mint"><Icon Name="shield" /></span></div><div class="metric-value">@ApprovalRate<span class="percent">%</span></div><div class="metric-foot">@Decided decisiones registradas</div></div>
</div>
<div class="overview-grid">
    <section class="panel pipeline-panel"><div class="panel-heading"><div><h2>Estado de las solicitudes</h2><p>Distribución de expedientes activos</p></div><a class="text-link" href="/solicitudes">Ver solicitudes <Icon Name="arrow" Size="16" /></a></div>
        <div class="pipeline-bar" aria-label="Distribución por estado">@foreach (var state in Enum.GetValues<ApplicationStatus>().Where(x => x != ApplicationStatus.Rejected)) {
            var count = apps.Count(a => a.Status == state);
            <div class="segment @state.ToString().ToLowerInvariant()" style="flex:@(Math.Max(count, .3))" title="@($"{Ui.Status(state)}: {count}")"></div>
        }</div>
        <div class="pipeline-legend">@foreach (var state in Enum.GetValues<ApplicationStatus>().Where(x => x != ApplicationStatus.Rejected)) {
            <a href="/solicitudes?estado=@state"><span class="legend-dot @state.ToString().ToLowerInvariant()"></span><span>@Ui.Status(state)<strong>@apps.Count(a => a.Status == state)</strong></span></a>
        }</div>
    </section>
    <section class="panel priorities"><div class="panel-heading"><h2>Por atender</h2><a class="text-link" href="/analisis">Abrir bandeja <Icon Name="arrow" Size="16" /></a></div><a class="priority-item" href="/solicitudes?estado=Submitted"><span class="priority-number violet">@apps.Count(a => a.Status == ApplicationStatus.Submitted)</span><div><strong>Recibidas</strong><p>Iniciar análisis</p></div><Icon Name="arrow" Size="16" /></a><a class="priority-item" href="/analisis"><span class="priority-number amber">@apps.Count(a => a.Status == ApplicationStatus.InReview)</span><div><strong>En análisis</strong><p>Revisar evidencia y decidir</p></div><Icon Name="arrow" Size="16" /></a><a class="priority-item" href="/solicitudes?estado=Approved"><span class="priority-number mint">@apps.Count(a => a.Status == ApplicationStatus.Approved)</span><div><strong>Aprobadas</strong><p>Preparar firma</p></div><Icon Name="arrow" Size="16" /></a></section>
</div>
<section class="panel recent-panel"><div class="panel-heading"><div><h2>Solicitudes recientes</h2><p>Últimos expedientes actualizados</p></div><a class="text-link" href="/solicitudes">Ver todas <Icon Name="arrow" Size="16" /></a></div><ApplicationTable Items="apps.Take(6)" /></section>
@code { IReadOnlyList<CreditApplication> apps = []; protected override async Task LoadAsync() => apps = await Workspace.ListAsync(CurrentActor); int Pending => apps.Count(a => a.Status is ApplicationStatus.Submitted or ApplicationStatus.InReview); int Approved => apps.Count(a => a.Status is ApplicationStatus.Approved or ApplicationStatus.SignaturePending); int Decided => Approved + apps.Count(a => a.Status == ApplicationStatus.Rejected); int ApprovalRate => Decided == 0 ? 0 : (int)Math.Round(Approved * 100m / Decided); }
