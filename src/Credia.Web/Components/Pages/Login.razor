@page "/login"
@inject IConfiguration Config
@inject IWebHostEnvironment Environment
<PageTitle>Ingresar · Credia</PageTitle>
<div class="login-page"><div class="login-language language-switch" role="group" aria-label="Language / Idioma"><button type="button" data-language="es" aria-label="Español">ES</button><button type="button" data-language="en" aria-label="English">EN</button></div>
    <section class="login-story"><a class="brand" href="/login"><span class="brand-symbol">c<span></span></span><span>credia.</span></a><div class="login-story-inner"><span class="eyebrow light">EL SIGUIENTE PASO, CON CONFIANZA</span><h1>Más posibilidades.<br />Mejores decisiones.</h1><p>Un solo lugar para conectar solicitudes, documentos y decisiones de crédito.</p><div class="login-visual"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="floating-card"><span class="icon-tile mint"><Icon Name="check" Size="26" /></span><div><strong>Decisiones con respaldo</strong><small>Cada dato tiene una historia.</small></div><span class="mini-check">✓</span></div><div class="floating-card second"><span class="icon-tile purple"><Icon Name="spark" Size="26" /></span><div><strong>Menos trabajo manual</strong><small>Más tiempo para tus clientes.</small></div></div></div></div><span class="login-foot">Una experiencia de crédito diseñada alrededor de las personas.</span></section>
    <section class="login-form-wrap"><div class="login-form"><span class="eyebrow">PORTAL COMERCIAL</span><h2>Qué bueno verte de nuevo.</h2><p>Ingresa a tu espacio de trabajo.</p>
        @if (Error is not null) {
    <div class="alert error" role="alert">No pudimos iniciar sesión. Revisa tus credenciales o espera si la cuenta está bloqueada.</div>
}
        <form action="/auth/login" method="post" data-enhance="false"><AntiforgeryToken /><label for="email">Correo electrónico</label><input id="email" type="email" name="email" required autocomplete="username" value="@(IsDemo ? "analista@credia.demo" : "")" /><label for="password">Contraseña</label><input id="password" type="password" name="password" required autocomplete="current-password" value="@(IsDemo ? "Credia.Demo2026!" : "")" /><button class="btn primary full" type="submit">Ingresar al portal <Icon Name="arrow" /></button></form>
        @if (IsDemo) {
    <div class="login-demo"><span class="tag">ACCESO DE DEMOSTRACIÓN</span><p>Analista preseleccionado. También puedes explorar:</p><div class="demo-accounts"><code>asesor@credia.demo</code><code>auditor@credia.demo</code></div><small>Contraseña compartida: <strong>Credia.Demo2026!</strong><br />Solo datos sintéticos. No ingreses información personal real.</small></div>
}
        <div class="login-secure"><Icon Name="shield" Size="16" /> Acceso por roles · Sesión segura · Trazabilidad</div>
    </div></section>
</div>
@code { [SupplyParameterFromQuery(Name="error")] public string? Error { get; set; } bool IsDemo => Environment.IsDevelopment() && Config.GetValue<bool>("Demo:Enabled"); }
