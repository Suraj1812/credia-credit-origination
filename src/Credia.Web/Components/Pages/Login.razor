@page "/login"
@inject IConfiguration Config
@inject IWebHostEnvironment Environment
<PageTitle>Ingresar · Credia</PageTitle>
<div class="login-page">
    <div class="login-language language-switch" role="group" aria-label="Language / Idioma"><button type="button" data-language="es" aria-label="Español" translate="no"><img class="flag" src="/images/flags/es.png" alt="" /><span class="language-code">ES</span></button><button type="button" data-language="en" aria-label="English" translate="no"><img class="flag" src="/images/flags/gb.png" alt="" /><span class="language-code">EN</span></button></div>
    <section class="login-story"><a class="brand" href="/login"><img class="brand-logo" src="/icon.svg" alt="" /><span>credia.</span></a><div class="login-story-inner"><span class="eyebrow light">DUFO · PORTAL COMERCIAL</span><h1 translate="no" class="login-title">Crédito con criterio.</h1><p>Solicitudes, evidencia y decisiones en un solo lugar.</p></div><span class="login-foot">Originación de crédito · Colombia</span></section>
    <section class="login-form-wrap"><div class="login-form"><span class="eyebrow">ACCESO AL PORTAL</span><h2>Iniciar sesión</h2><p>Ingresa con tu cuenta de trabajo.</p>
        @if (Error is not null) {
    <div class="alert error" role="alert">No pudimos iniciar sesión. Revisa tus credenciales o espera si la cuenta está bloqueada.</div>
}
        <form action="/auth/login" method="post" data-enhance="false"><AntiforgeryToken /><label for="email">Correo electrónico</label><input id="email" type="email" name="email" required autocomplete="username" value="@(IsDemo ? "analista@credia.demo" : "")" /><label for="password">Contraseña</label><input id="password" type="password" name="password" required autocomplete="current-password" value="@(IsDemo ? "Credia.Demo2026!" : "")" /><button class="btn primary full" type="submit">Ingresar <Icon Name="arrow" /></button></form>
        @if (IsDemo) {
    <div class="login-demo"><strong>Acceso de demostración</strong><p>Analista preseleccionado. Otras cuentas:</p><div class="demo-accounts"><code>asesor@credia.demo</code><code>auditor@credia.demo</code></div><small>Contraseña: <strong>Credia.Demo2026!</strong><br />Usa únicamente datos ficticios.</small></div>
}
    </div></section>
</div>
@code { [SupplyParameterFromQuery(Name="error")] public string? Error { get; set; } bool IsDemo => Environment.IsDevelopment() ? Config.GetValue<bool>("Demo:Enabled") : Config.GetValue<bool>("Demo:Public"); }
