@page "/solicitudes/nueva"
@attribute [Authorize(Roles="Advisor,Analyst,Admin")]
@inherits WorkspacePage
<PageTitle>Nueva solicitud · Credia</PageTitle>
<a class="back-link" href="/solicitudes">← Volver a solicitudes</a>
<div class="page-heading"><div><div class="eyebrow">ALTA DE SOLICITUD</div><h1>Nueva solicitud<span class="heading-dot">.</span></h1><p>Registra al solicitante y las condiciones del crédito.</p></div><span class="subtle-pill">Paso @(step + 1) de 3</span></div>
<div class="intake-grid"><section class="panel intake-panel"><div class="steps">@for (var i = 0; i < 3; i++) {
    <div class="step @(step == i ? "active" : "") @(step > i ? "complete" : "")"><span>@(step > i ? "✓" : (i + 1).ToString())</span>@(new[]{"Solicitante", "Financiación", "Confirmación"}[i])</div>
}</div>
<Feedback Error="Error" />
<EditForm Model="model" OnValidSubmit="Save" FormName="new-application"><DataAnnotationsValidator /><ValidationSummary />
@if (step == 0) {
    <div class="form-section"><h2>Datos del solicitante</h2><p>Identificación y contacto.</p><div class="form-grid"><div class="field span-2"><label for="borrower">Nombre completo</label><InputText id="borrower" @bind-Value="model.BorrowerName" placeholder="Ej. María Fernanda Gómez" /><ValidationMessage For="() => model.BorrowerName" /></div><div class="field"><label for="doc">Cédula de ciudadanía</label><InputText id="doc" @bind-Value="model.DocumentNumber" placeholder="Número sin puntos" /><ValidationMessage For="() => model.DocumentNumber" /></div><div class="field"><label for="city">Ciudad</label><InputText id="city" @bind-Value="model.City" /><ValidationMessage For="() => model.City" /></div><div class="field"><label for="email">Correo electrónico</label><InputText id="email" type="email" @bind-Value="model.Email" placeholder="nombre@correo.com" /><ValidationMessage For="() => model.Email" /></div><div class="field"><label for="phone">Celular</label><InputText id="phone" @bind-Value="model.Phone" placeholder="300 000 0000" /><ValidationMessage For="() => model.Phone" /></div><div class="field span-2"><label for="employment">Actividad económica</label><InputSelect id="employment" @bind-Value="model.Employment"><option>Empleado</option><option>Independiente</option><option>Pensionado</option></InputSelect></div></div></div>
} else if (step == 1) {
    <div class="form-section"><h2>Condiciones del crédito</h2><p>Valores en pesos colombianos (COP).</p><div class="form-grid"><div class="field span-2"><label for="product">Línea de crédito</label><InputSelect id="product" @bind-Value="model.Product"><option>Libre inversión</option><option>Capital de trabajo</option><option>Compra de cartera</option></InputSelect></div><div class="field"><label for="amount">Monto solicitado</label><InputNumber id="amount" @bind-Value="model.Amount" /><ValidationMessage For="() => model.Amount" /></div><div class="field"><label for="term">Plazo (meses)</label><InputSelect id="term" @bind-Value="model.TermMonths"><option value="6">6 meses</option><option value="12">12 meses</option><option value="24">24 meses</option><option value="36">36 meses</option><option value="48">48 meses</option><option value="60">60 meses</option></InputSelect></div><div class="field"><label for="income">Ingreso mensual</label><InputNumber id="income" @bind-Value="model.MonthlyIncome" /><ValidationMessage For="() => model.MonthlyIncome" /></div><div class="field"><label for="expenses">Gastos mensuales</label><InputNumber id="expenses" @bind-Value="model.MonthlyExpenses" /><ValidationMessage For="() => model.MonthlyExpenses" /></div><div class="field span-2"><label for="debt">Cuotas de obligaciones actuales / mes</label><InputNumber id="debt" @bind-Value="model.ExistingDebtPayment" /><ValidationMessage For="() => model.ExistingDebtPayment" /></div><div class="field span-2"><label for="purpose">¿Para qué necesita el crédito?</label><InputTextArea id="purpose" rows="3" @bind-Value="model.Purpose" placeholder="Describe el destino del crédito (mínimo 10 caracteres)." /><ValidationMessage For="() => model.Purpose" /></div></div></div>
} else {
    <div class="form-section"><h2>Revisar solicitud</h2><p>Confirma los datos antes de continuar.</p><div class="review-summary"><div><small>Solicitante</small><strong>@model.BorrowerName</strong></div><div><small>Identificación</small><strong>@model.DocumentNumber</strong></div><div><small>Contacto</small><strong>@model.Email</strong></div><div><small>Producto</small><strong>@model.Product</strong></div><div><small>Monto / plazo</small><strong>@Ui.Money(model.Amount) · @model.TermMonths meses</strong></div><div><small>Ingreso mensual</small><strong>@Ui.Money(model.MonthlyIncome)</strong></div></div><label class="consent"><InputCheckbox @bind-Value="model.Consent" /><span>Confirmo que cuento con la autorización del titular para el tratamiento de sus datos y la consulta de información necesaria para esta solicitud.</span></label><ValidationMessage For="() => model.Consent" /><div class="alert neutral"><Icon Name="info" /> Este es un entorno de portafolio. Utiliza únicamente datos ficticios.</div></div>
}
<div class="form-footer">@if (step > 0) {
    <span><button class="btn secondary" type="button" disabled="@Busy" @onclick="() => step--">← Anterior</button></span>
} else {
    <span><a href="/solicitudes" class="btn secondary">Cancelar</a></span>
}
@if (step < 2) {
    <span><button class="btn primary" type="button" @onclick="Next">Continuar <Icon Name="arrow" Size="17" /></button></span>
} else {
    <span><button class="btn primary" type="submit" disabled="@Busy">@(Busy ? "Guardando…" : "Crear solicitud") <Icon Name="check" Size="17" /></button></span>
}</div>
</EditForm></section><aside><div class="estimate-card"><span class="eyebrow">RESUMEN DEL CRÉDITO</span><h3>@model.Product</h3><small>Monto solicitado</small><div class="estimate-amount">@Ui.Money(model.Amount)</div><div class="estimate-row"><span>Plazo</span><strong>@model.TermMonths meses</strong></div><div class="estimate-row"><span>Tasa ilustrativa E.A.</span><strong>24,00%</strong></div><div class="estimate-total"><span>Cuota estimada / mes</span><strong>@(model.Amount > 0 && model.TermMonths is >= 6 and <= 60 ? Ui.Money(CreditPolicy.CalculateInstallment(model.Amount, model.TermMonths)) : "—")</strong></div><p>Simulación académica, sin seguros ni cargos. No es una oferta comercial ni una decisión de aprobación.</p></div><div class="intake-tip"><Icon Name="shield" Size="24" /><h3>Registro de cambios</h3><p>Los cambios quedan registrados por usuario.</p></div></aside></div>
@code {
    ApplicationInput model = new(); int step;
    void Next() {
        string[] fields = step == 0 ? ["BorrowerName", "DocumentNumber", "Email", "Phone", "City", "Employment"] : ["Amount", "TermMonths", "MonthlyIncome", "MonthlyExpenses", "ExistingDebtPayment", "Purpose", "Product"];
        var errors = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
        foreach (var name in fields) System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(typeof(ApplicationInput).GetProperty(name)!.GetValue(model), new(model) { MemberName = name }, errors);
        Error = errors.Count == 0 ? null : string.Join(" ", errors.Select(e => e.ErrorMessage));
        if (Error is null) step++;
    }
    async Task Save() { if (step != 2) return; await Run(async () => { var id = await Workspace.CreateAsync(model, CurrentActor); Navigation.NavigateTo($"/solicitudes/{id}"); }); }
}
